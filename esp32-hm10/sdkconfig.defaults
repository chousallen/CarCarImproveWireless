# Bluetooth Configuration
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_GATTC_ENABLE=y

# HM-10 Device Configuration
CONFIG_HM10_DEVICE_NAME="HMSoft"
CONFIG_HM10_DEVICE_MAC=""

# Flash and log settings (carried over from the IDF 5.5.2 sdkconfig)
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_LOG_COLORS=y
